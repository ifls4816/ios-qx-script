#!name=铁路12306
#!desc=过滤12306应用内广告及开屏广告
#!openUrl=https://apps.apple.com/app/id564818797
#!author=RuCu6[https://github.com/RuCu6]
#!tag=去广告
#!system=
#!system_version=
#!loon_version=3.5.1(998)
#!homepage=https://github.com/ifls4816/ios-qx-script/tree/master/loon/plugins
#!date=2026-10-02 13:57:49

[Rule]
DOMAIN, ad.12306.cn, DIRECT

[Rewrite]
response if ${url} ~= /^https:\/\/ad\.12306\.cn\/ad\/ser\/getAdList$/i then response.json.delete(["materialsList", "advertParam"])

[Script]

request if ${url} ~= /^https:\/\/mobile\.12306\.cn\/otsmobile\/app\/mgs\/mgw\.htm$/i then script("https://raw.githubusercontent.com/ifls4816/ios-qx-script/master/loon/scripts/12306.js") with tag="移除12306应用内广告"

[MitM]
hostname=ad.12306.cn, mobile.12306.cn