#!name=酷安
#!date=2026-11-03
#!homepage=https://github.com/ifls4816/ios-qx-script/tree/master/loon/plugins
#!desc=过滤酷安广告、话题页红包弹窗与搜索框推广词
#!openUrl=https://apps.apple.com/app/id1422581869
#!author=RuCu6[https://github.com/RuCu6]
#!tag=去广告
#!loon_version=3.5.1

[Rewrite]
request if ${url} ~= /^https:\/\/api\.coolapk\.com\/v6\/search\?.*type=hotSearch/i then reject_dict(200)

[Script]
response if ${url} ~= /^https:\/\/api\.coolapk\.com\/v6\/(topic\/newTagDetail|feed\/detail\?|feed\/replyList|main\/dataList|page\/dataList|main\/indexV8|main\/init)/i then script("https://raw.githubusercontent.com/ifls4816/ios-qx-script/master/loon/scripts/CoolApk.js") with tag="酷安去广告", requires_body=true

[MitM]
# 只解密规则用到的域名
hostname = api.coolapk.com
