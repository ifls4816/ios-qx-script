#!name=高德地图去广告
#!desc=过滤开屏广告、首页扫街榜图标、我的页面推广卡片及各页面推广，拦截日志与众包数据上报。基于 RuCu6 / kelee 规则修改。
#!openUrl=https://apps.apple.com/app/id461703208
#!tag=去广告
#!system=
#!system_version=
#!loon_version=3.5.1(998)
#!homepage=https://github.com/ifls4816/ios-qx-script/tree/master/loon/adblock/amap
#!icon=https://raw.githubusercontent.com/luestr/IconResource/main/App_icon/120px/Amap.png
#!date=2026-10-03

[Rule]
# 来自 RuCu6：拦截阿里 AMDC 调度，迫使高德走普通 HTTPS（否则请求走长连接，MitM 改不到）
AND, ((URL-REGEX, "^http:\/\/.+\/amdc\/mobileDispatch"), (USER-AGENT, "AMapiPhone*")), REJECT
# 来自 kelee
DOMAIN, amap-aos-info-nogw.amap.com, REJECT
DOMAIN, free-aos-cdn-image.amap.com, REJECT
DOMAIN-SUFFIX, v.smtcdns.com, REJECT

[Rewrite]

request if ${url} ~= /^https:\/\/m5\.amap\.com\/ws\/shield\/search\/new_hotword\?/i then reject_dict(200)
request if ${url} ~= /^https:\/\/m5\.amap\.com\/ws\/faas\/amap-navigation\/card-service-(?:car-end|route-plan)/i then reject_dict(200)
response if ${url} ~= /^https:\/\/m5\.amap\.com\/ws\/shield\/search_business\/process\/marketingOperationStructured\?/i then response.json.delete(["data.commonMaterial", "data.tipsOperationLocation", "data.resourcePlacement"])
response if ${url} ~= /^https:\/\/m5\.amap\.com\/ws\/shield\/search_poi\/homepage\?/i then response.json.delete("history_tags")
request if ${url} ~= /^https:\/\/m5\.amap\.com\/ws\/shield\/search_poi\/tips_adv\?/i then reject_dict(200)
request if ${url} ~= /^https:\/\/oss\.amap\.com\/ws\/banner\/lists\/\?/i then reject_dict(200)

request if ${url} ~= /^https:\/\/ai\.amap\.com\/v1\/ai_rec\//i then reject_dict(200)
request if ${url} ~= /^https:\/\/m5\.amap\.com\/ws\/aos\/main\/page\/product\/list\?/i then reject_dict(200)
request if ${url} ~= /^https:\/\/m5\.amap\.com\/ws\/faas\/amap-navigation\/(?:main-page-assets|main-page-location|ridewalk-end-fc|usr-profile-fc\/homeV2)/i then reject_dict(200)
request if ${url} ~= /^https:\/\/m5\.amap\.com\/ws\/(?:mapapi\/hint_text\/offline_data|message\/notice\/list|shield\/search\/new_hotword)/i then reject_dict(200)
request if ${url} ~= /^https:\/\/m5\.amap\.com\/ws\/shield\/scene\/recommend\?/i then reject_dict(200)
request if ${url} ~= /^https:\/\/m5\.amap\.com\/ws\/valueadded\/weather\/v2\?/i then reject_dict(200)
request if ${url} ~= /^https:\/\/sns\.amap\.com\/ws\/msgbox\/pull_mp\?/i then reject_dict(200)

# 来自 RuCu6：附近卡片
request if ${url} ~= /^https:\/\/m5\.amap\.com\/ws\/c3frontend\/af-comment\/contentNearbyCard\?/i then reject_dict(200)
request if ${url} ~= /^https:\/\/m5-zb\.amap\.com\/ws\/boss\/(?:order\/car\/(?:feedback\/get_card_questions|feedback\/viptips|king_toolbox_car_bubble|remark\/satisfactionConf|rights_information)|tips\/onscene_visual_optimization)/i then reject_dict(200)
request if ${url} ~= /^https:\/\/m5-zb\.amap\.com\/ws\/boss\/(?:pay\/web\/paySuccess\/info\/request|transportation\/diversion\/resource\/driving)/i then reject_dict(200)
response if ${url} ~= /^https:\/\/m5-zb\.amap\.com\/ws\/sharedtrip\/taxi\/order_detail_car_tips\?/i then response.json.delete("data.carTips.data.popupInfo")

# 日志上报：本地直接返回空的成功响应，数据不发出去。账号安全(device_reporting)、会话(session-report)、同步(sync) 不拦，避免风控和功能异常
request if ${url} ~= /^https:\/\/m5-x\.amap\.com\/+ws\/shield\/(?:alc\/collect|amapstream\/upload)/i then reject_dict(200)
request if ${url} ~= /^https:\/\/awaken\.amap\.com\/ws\/h5_log/i then reject_dict(200)
request if ${url} ~= /^https:\/\/m5\.amap\.com\/ws\/user\/fatigue\/report/i then reject_dict(200)
# 众包数据上传（定位指纹、路况采集）
request if ${url} ~= /^https:\/\/fp\.amap\.com\/ws\/shield\/location\/fp\/reports/i then reject_dict(200)
request if ${url} ~= /^https:\/\/m5\.amap\.com\/ws\/shield\/highway\/collect/i then reject_dict(200)

[Script]
response if ${url} ~= /^https:\/\/m5\.amap\.com\/ws\/aos\/perception\/publicTravel\/beforeNavi\?/i then script("https://raw.githubusercontent.com/ifls4816/ios-qx-script/master/loon/adblock/amap/Amap_remove_ads.js") with tag="移除路线规划推广", requires_body=true
response if ${url} ~= /^https:\/\/m5\.amap\.com\/ws\/bus\/plan\/integrate\?/i then script("https://raw.githubusercontent.com/ifls4816/ios-qx-script/master/loon/adblock/amap/Amap_remove_ads.js") with tag="移除路线规划、导航结束页推广", requires_body=true
response if ${url} ~= /^https:\/\/m5\.amap\.com\/ws\/c3frontend\/(?:af-(?:hotel|launch)\/page\/main|af-nearby\/nearby)/i then script("https://raw.githubusercontent.com/ifls4816/ios-qx-script/master/loon/adblock/amap/Amap_remove_ads.js") with tag="移除导航详情页底部酒店、处理附近页", requires_body=true
response if ${url} ~= /^https:\/\/m5\.amap\.com\/ws\/perception\/drive\/(?:routeInfo|routePlan)/i then script("https://raw.githubusercontent.com/ifls4816/ios-qx-script/master/loon/adblock/amap/Amap_remove_ads.js") with tag="移除路线规划推广", requires_body=true
response if ${url} ~= /^https:\/\/m5\.amap\.com\/ws\/shield\/search_bff\/hotword\?/i then script("https://raw.githubusercontent.com/ifls4816/ios-qx-script/master/loon/adblock/amap/Amap_remove_ads.js") with tag="移除搜索栏推广", requires_body=true
response if ${url} ~= /^https:\/\/m5\.amap\.com\/ws\/shield\/search_poi\/(?:mps|search\/sp|sug|tips_operation_location)/i then script("https://raw.githubusercontent.com/ifls4816/ios-qx-script/master/loon/adblock/amap/Amap_remove_ads.js") with tag="移除搜索详情页推广", requires_body=true
response if ${url} ~= /^https:\/\/m5\.amap\.com\/ws\/faas\/amap-navigation\/(?:card-service-plan-home|main-page)/i then script("https://raw.githubusercontent.com/ifls4816/ios-qx-script/master/loon/adblock/amap/Amap_remove_ads.js") with tag="移除首页推广", requires_body=true
response if ${url} ~= /^https:\/\/m5\.amap\.com\/ws\/shield\/frogserver\/aocs\/updatable\/1\?/i then script("https://raw.githubusercontent.com/ifls4816/ios-qx-script/master/loon/adblock/amap/Amap_remove_ads.js") with tag="移除首页推广", requires_body=true
response if ${url} ~= /^https:\/\/m5\.amap\.com\/ws\/shield\/dsp\/profile\/index\/nodefaasv3\?/i then script("https://raw.githubusercontent.com/ifls4816/ios-qx-script/master/loon/adblock/amap/Amap_remove_ads.js") with tag="移除我的页面推广", requires_body=true
response if ${url} ~= /^https:\/\/m5\.amap\.com\/ws\/shield\/search\/nearbyrec_smart\?/i then script("https://raw.githubusercontent.com/ifls4816/ios-qx-script/master/loon/adblock/amap/Amap_remove_ads.js") with tag="移除附近页推广", requires_body=true
response if ${url} ~= /^https:\/\/m5\.amap\.com\/ws\/valueadded\/alimama\/splash_screen\?/i then script("https://raw.githubusercontent.com/ifls4816/ios-qx-script/master/loon/adblock/amap/Amap_remove_ads.js") with tag="移除开屏广告", requires_body=true
response if ${url} ~= /^https:\/\/m5-zb\.amap\.com\/ws\/boss\/(?:car\/order\/content_info|order_web\/friendly_information)/i then script("https://raw.githubusercontent.com/ifls4816/ios-qx-script/master/loon/adblock/amap/Amap_remove_ads.js") with tag="移除打车页推广卡片、弹窗", requires_body=true
response if ${url} ~= /^https:\/\/m5-zb\.amap\.com\/ws\/promotion-web\/resource(\/home)?\?/i then script("https://raw.githubusercontent.com/ifls4816/ios-qx-script/master/loon/adblock/amap/Amap_remove_ads.js") with tag="移除打车页红点角标、天气图标", requires_body=true
response if ${url} ~= /^https:\/\/(?:info|m5)\.amap\.com\/ws\/shield\/search\/(?:common\/coupon\/info|poi\/detail)/i then script("https://raw.githubusercontent.com/ifls4816/ios-qx-script/master/loon/adblock/amap/Amap_remove_ads.js") with tag="移除导航详情页推广", requires_body=true

response if ${url} ~= /^https:\/\/sns\.amap\.com\/ws\/opc\/tools\/list/i then script("https://raw.githubusercontent.com/ifls4816/ios-qx-script/master/loon/adblock/amap/Amap_remove_ads.js") with tag="移除工具箱扫街榜", requires_body=true

[MitM]
# 只解密规则用到的域名
hostname = m5.amap.com, oss.amap.com, ai.amap.com, sns.amap.com, m5-zb.amap.com, m5-x.amap.com, awaken.amap.com, fp.amap.com, info.amap.com
