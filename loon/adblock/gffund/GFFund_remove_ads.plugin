#!name=广发基金去广告
#!date=2026-10-03
#!homepage=https://github.com/ifls4816/ios-qx-script/tree/master/loon/adblock/gffund
#!desc=移除广发基金 App 开屏广告（只删开屏条目，首页横幅不受影响；开屏后约 4 秒的等待为 App 内置计时，无法去除）。
#!tag=去广告
#!loon_version=3.5.1(998)

[Script]
# 开屏广告：get_banner_info 只删「开屏」条目
response if ${url} ~= /^https:\/\/m\.gffunds\.com\.cn\/gff\/api\/get_banner_info\.vir/i then script("https://raw.githubusercontent.com/ifls4816/ios-qx-script/master/loon/adblock/gffund/GFFund_remove_ads.js") with tag="移除开屏广告", requires_body=true

[MitM]
# 只解密规则用到的域名
hostname = m.gffunds.com.cn
