#!name=广发基金去广告
#!date=2026-10-03
#!homepage=https://github.com/ifls4816/ios-qx-script/tree/master/loon/adblock/gffund
#!desc=移除广发基金 App 开屏广告（只删开屏条目，首页横幅不受影响；开屏后约 4 秒的等待为 App 内置计时，无法去除）。
#!tag=去广告
#!loon_version=3.5.1(998)

[Rewrite]
# 开屏广告：get_banner_info 与首页各位置横幅共用，只删 exposure_way 为「开屏」的条目（Loon 内置 jq，无需脚本）
response if ${url} ~= /^https:\/\/m\.gffunds\.com\.cn\/gff\/api\/get_banner_info\.vir/i then response.json.jq("if (.banner_list | type) == \"array\" then .banner_list |= map(select(.exposure_way != \"开屏\")) else . end")

[MitM]
# 只解密规则用到的域名
hostname = m.gffunds.com.cn
